# .NET
bin/
obj/
*.user
*.suo

# 前端
node_modules/
web/dist/
web/.vite/
web/node_modules/.tmp/

# 本地数据（SQLite 库文件、WAL、备份均已由运行时生成）
#
# 这条是仓库里**最要紧**的忽略规则：交易所 API 凭据是明文存在库里的
# （加密那套已被明确移除），而库、它的 WAL 与任何副本都含同样的数据。
# 用 *.db* 一次盖住 .db / .db-wal / .db-shm / .db.bak-*：
# 注意不能拆成 "*.db" + "*.db.*"——后者匹配不到 -wal/-shm（那是横线不是点）。
data/*.db*

# 采集到的原始载荷与快照（体积大，可重新拉取）
data/cache/

# 将来的密钥材料：绝不进仓库
*.key
secrets*.json

# 工具与系统
.DS_Store
.vs/
.idea/

# 本地起服务时的输出（后端 / 前端各一份）
.dev-logs/

# Linux 包构建产物
packaging/out/
*.deb

# 编码助手的会话产物（计划、临时脚本、本机 MCP 配置等），与项目本身无关
.zcode/
.codex/
