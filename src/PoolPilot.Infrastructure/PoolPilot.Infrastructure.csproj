    只做技术实现，不含业务决策。
  -->

  <ItemGroup>
    <ProjectReference Include="..\PoolPilot.Domain\PoolPilot.Domain.csproj" />
    <ProjectReference Include="..\PoolPilot.Application\PoolPilot.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
