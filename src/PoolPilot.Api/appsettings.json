{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",

      // 库的 HttpClient 按 info 级逐请求打日志（一个请求四行）。走库之后
      // 每个池的快照、每份合约目录都要发请求，不压下去一天就是几万行——
      // 与 EF Core 同样的理由。上游出错时它仍会以 Warning 以上级别报出来。
      "System.Net.Http.HttpClient.ILighterRestClient": "Warning",
      "System.Net.Http.HttpClient.IBinanceRestClient": "Warning",
      "System.Net.Http.HttpClient.IBinanceSocketClient": "Warning",
      "System.Net.Http.HttpClient.IOKXRestClient": "Warning",
      "System.Net.Http.HttpClient.IGateIoRestClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiveTrading": {
    "Enabled": true,
    "Leverage": 10
  },
  // 公开面（/api/public/*）的总开关，**默认全关**：这两页匿名可达，
  // 打开之前要确认这台部署确实想对外。数量上限不在这里——那是代码常量
  // （PoolPilot.Domain.Constants.PublicPageLimits），回退方式是改常量重新发布。
  // 关掉时对应端点回 404（不是 403）：没开放的功能不该让人探测得出它存在。
  "PublicPages": {
    "Leads": false,
    "Followers": false
  },
  // 登录/注册总开关：公开-only 部署设为 false 后，登录、注册、MFA 与首次初始化端点回 404。
  // 默认保持 true，否则第一次部署无法创建管理员。
  "Auth": {
    "AccountsEnabled": true
  },
  "LeadTraders": {
    "Enabled": true,
    "SeedAccountIndexes": [
      281474976552443
    ],
    "OrderBookCacheSeconds": 20,
    "StatusHeartbeatSeconds": 15,
    "EquityPointIntervalSeconds": 300,
    "PaperRestReconcileSeconds": 60
  }
}
