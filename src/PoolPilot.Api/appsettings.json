{
  "Logging": {
    "LogLevel": {
      // 默认只看 Warning 及以上：第三方库（Binance/OKX/Gate/Lighter、CryptoExchange.Net）
      // 会把连接、合约规则更新之类打成 Information，量大且没有运维价值。
      // 本项目自己的 Information 也一并压掉，日志里只留警告与错误。
      //
      // 排障需要看订阅关系/信号产出时，临时用环境变量打开本项目的 Information，
      // 不要改回全局 Information：
      //   Logging__LogLevel__PoolPilot=Information
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiveTrading": {
    "Enabled": true,
    "Leverage": 10
  },
  // 公开面（/api/public/*）的总开关，**默认全关**：这两页匿名可达，
  // 打开之前要确认这台部署确实想对外。数量上限不在这里——那是代码常量
  // （PoolPilot.Domain.Constants.PublicPageLimits），回退方式是改常量重新发布。
  // 关掉时对应端点回 404（不是 403）：没开放的功能不该让人探测得出它存在。
  "PublicPages": {
    "Leads": false,
    "Followers": false
  },
  // 登录/注册总开关：公开-only 部署设为 false 后，登录、注册、MFA 与首次初始化端点回 404。
  // 默认保持 true，否则第一次部署无法创建管理员。
  "Auth": {
    "AccountsEnabled": true
  },
  "LeadTraders": {
    "Enabled": true,
    "SeedAccountIndexes": [
      281474976552443
    ],
    "OrderBookCacheSeconds": 20,
    "StatusHeartbeatSeconds": 15,
    "EquityPointIntervalSeconds": 300,
    "PaperRestReconcileSeconds": 60
  }
}
