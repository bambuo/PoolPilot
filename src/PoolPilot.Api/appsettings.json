{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",

      // 库的 HttpClient 按 info 级逐请求打日志（一个请求四行）。走库之后
      // 每个池的快照、每份合约目录都要发请求，不压下去一天就是几万行——
      // 与 EF Core 同样的理由。上游出错时它仍会以 Warning 以上级别报出来。
      "System.Net.Http.HttpClient.ILighterRestClient": "Warning",
      "System.Net.Http.HttpClient.IBinanceRestClient": "Warning",
      "System.Net.Http.HttpClient.IBinanceSocketClient": "Warning",
      "System.Net.Http.HttpClient.IOKXRestClient": "Warning",
      "System.Net.Http.HttpClient.IGateIoRestClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LiveTrading": {
    "Enabled": true,
    "Leverage": 10
  },
  "LeadTraders": {
    "Enabled": true,
    "SeedAccountIndexes": [
      281474976552443
    ],
    "OrderBookCacheSeconds": 20,
    "StatusHeartbeatSeconds": 15,
    "EquityPointIntervalSeconds": 300,
    "PaperRestReconcileSeconds": 60
  }
}
